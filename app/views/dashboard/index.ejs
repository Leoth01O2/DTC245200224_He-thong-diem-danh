<%- include('../partials/header', { title: 'Tổng quan' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="page-header">
        <div>
            <h1>Bảng điều khiển Tổng quan</h1>
            <p class="text-muted">Dữ liệu thời gian thực từ cơ sở dữ liệu MySQL - Ngày: <strong><%= formatDateVN(today) %></strong> (Giờ Việt Nam)</p>
        </div>
        <div>
            <a href="/attendance" class="btn btn-success">Thực hiện Điểm danh</a>
        </div>
    </div>

    <!-- Hàng thống kê tổng quan -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-details">
                <span class="stat-value"><%= stats.totalMembers %></span>
                <span class="stat-label">Tổng thành viên</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-details">
                <span class="stat-value"><%= stats.totalShifts %></span>
                <span class="stat-label">Tổng số ca</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-details">
                <span class="stat-value"><%= stats.checkedInToday %></span>
                <span class="stat-label">Đã check-in hôm nay</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-details">
                <span class="stat-value text-success"><%= stats.onTimeToday %></span>
                <span class="stat-label">Đúng giờ hôm nay</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-details">
                <span class="stat-value text-danger"><%= stats.lateToday %></span>
                <span class="stat-label">Đi muộn hôm nay</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-details">
                <span class="stat-value"><%= stats.checkedOutToday %> / <%= stats.notCheckedOutToday %></span>
                <span class="stat-label">Đã / Chưa check-out</span>
            </div>
        </div>
    </div>

    <!-- Bảng điểm danh mới nhất hôm nay -->
    <div class="content-card">
        <div class="card-header">
            <h3>Lượt điểm danh mới nhất hôm nay (<%= formatDateVN(today) %>)</h3>
            <a href="/attendance/history" class="btn btn-outline btn-sm">Xem toàn bộ lịch sử</a>
        </div>
        <div class="card-body">
            <% if (recentAttendances && recentAttendances.length > 0) { %>
                <div class="table-responsive">
                    <table class="table-standard">
                        <thead>
                            <tr>
                                <th>Mã số</th>
                                <th>Họ và tên</th>
                                <th>Khoa / Phòng ban</th>
                                <th>Ca làm việc</th>
                                <th>Giờ check-in</th>
                                <th>Giờ check-out</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentAttendances.forEach(item => { %>
                                <tr>
                                    <td><strong><%= item.member_code %></strong></td>
                                    <td><%= item.member_name %></td>
                                    <td><%= item.department %></td>
                                    <td><%= item.shift_name %></td>
                                    <td><span class="badge badge-info"><%= formatTimeVN(item.check_in) %></span></td>
                                    <td>
                                        <% if (item.check_out) { %>
                                            <span class="badge badge-secondary"><%= formatTimeVN(item.check_out) %></span>
                                        <% } else { %>
                                            <span class="badge badge-warning">Chưa check-out</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.status === 'on_time') { %>
                                            <span class="badge badge-success">Đúng giờ</span>
                                        <% } else { %>
                                            <span class="badge badge-danger">Đi muộn</span>
                                        <% } %>
                                    </td>
                                    <td><%= item.notes || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>Chưa có lượt điểm danh nào trong ngày hôm nay.</p>
                    <a href="/attendance" class="btn btn-primary btn-sm mt-2">Thực hiện điểm danh ngay</a>
                </div>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
