<%- include('../partials/header', { title: 'Thực hiện Điểm danh' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="page-header">
        <div>
            <h1>Thực hiện Điểm danh (Check-in / Check-out)</h1>
            <p class="text-muted">Thời gian thực tế: <strong id="realtimeClock"><%= formatTimeVN(currentTime) %></strong> | Ngày: <strong><%= formatDateVN(today) %></strong> (Giờ Việt Nam)</p>
        </div>
        <div class="page-header-actions">
            <a href="/attendance/history" class="btn btn-outline">
                <span class="material-symbols-outlined btn-icon">history</span>
                <span>Tra cứu Lịch sử</span>
            </a>
        </div>
    </div>

    <% if (success) { %>
        <div class="alert alert-success">
            <span class="material-symbols-outlined alert-icon">check_circle</span>
            <span><%= success %></span>
        </div>
    <% } %>

    <% if (error) { %>
        <div class="alert alert-danger">
            <span class="material-symbols-outlined alert-icon">error</span>
            <span><%= error %></span>
        </div>
    <% } %>

    <div class="attendance-layout">
        <div class="content-card attendance-card">
            <div class="card-header">
                <h3>Điểm danh vào ca (Check-in)</h3>
            </div>
            <div class="card-body">
                <form action="/attendance/check-in" method="POST" class="form-standard">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                        <label for="member_select">Chọn Thành viên (hoặc gõ mã bên dưới) *</label>
                        <select id="member_select" class="form-control">
                            <option value="">-- Chọn thành viên từ danh sách --</option>
                            <% members.forEach(m => { %>
                                <option value="<%= m.code %>"><%= m.code %> - <%= m.full_name %> (<%= m.department %>)</option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="member_code">Mã Thành viên *</label>
                        <input type="text" id="member_code" name="member_code" class="form-control" placeholder="Nhập mã thành viên, ví dụ: NV001" maxlength="20" required>
                    </div>

                    <div class="form-group">
                        <label for="shift_id">Ca làm việc *</label>
                        <select id="shift_id" name="shift_id" class="form-control" required>
                            <option value="">-- Chọn ca áp dụng --</option>
                            <% shifts.forEach(s => { %>
                                <option value="<%= s.id %>">
                                    <%= s.name %> [<%= formatTimeVN(s.start_time) %> - <%= formatTimeVN(s.end_time) %>] (Ân hạn: <%= s.late_after_minutes %> phút)
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="notes">Ghi chú (tùy chọn)</label>
                        <input type="text" id="notes" name="notes" class="form-control" placeholder="Ghi chú lý do nếu có..." maxlength="255">
                    </div>

                    <div class="attendance-notice">
                        <small class="text-muted">
                            Lưu ý: Hệ thống tự động so sánh giờ hiện tại với giờ bắt đầu ca cộng thêm số phút ân hạn để ghi nhận <strong>Đúng giờ</strong> hoặc <strong>Đi muộn</strong>.
                        </small>
                    </div>

                    <button type="submit" class="btn btn-success btn-block mt-3">
                        <span class="material-symbols-outlined btn-icon">login</span>
                        <span>Xác nhận Check-in</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="content-card today-list-card">
            <div class="card-header">
                <h3>Danh sách đã điểm danh hôm nay (<%= todayAttendances.length %> lượt)</h3>
            </div>
            <div class="card-body">
                <% if (todayAttendances && todayAttendances.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table-standard">
                            <thead>
                                <tr>
                                    <th>Mã số</th>
                                    <th>Họ và tên</th>
                                    <th>Ca làm việc</th>
                                    <th>Check-in</th>
                                    <th>Check-out</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% todayAttendances.forEach(att => { %>
                                    <tr>
                                        <td><strong><%= att.member_code %></strong></td>
                                        <td><span class="text-truncate-name" title="<%= att.member_name %>"><%= att.member_name %></span></td>
                                        <td><span class="text-truncate-sm" title="<%= att.shift_name %>"><%= att.shift_name %></span></td>
                                        <td><span class="badge badge-info"><%= formatTimeVN(att.check_in) %></span></td>
                                        <td>
                                            <% if (att.check_out) { %>
                                                <span class="badge badge-secondary"><%= formatTimeVN(att.check_out) %></span>
                                            <% } else { %>
                                                <span class="badge badge-warning">Chưa check-out</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (att.status === 'on_time') { %>
                                                <span class="badge badge-success">Đúng giờ</span>
                                            <% } else { %>
                                                <span class="badge badge-danger">Đi muộn</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (!att.check_out) { %>
                                                <form action="/attendance/check-out" method="POST" class="inline-form">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <input type="hidden" name="attendance_id" value="<%= att.id %>">
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        <span class="material-symbols-outlined btn-icon-sm">logout</span>
                                                        <span>Check-out</span>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-muted text-sm">Đã xong</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <span class="material-symbols-outlined empty-icon">assignment</span>
                        <p>Chưa có ai check-in trong ngày hôm nay.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
