<%- include('../partials/header', { title: 'Lịch sử Điểm danh' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="page-header">
        <div>
            <h1>Lịch sử Điểm danh</h1>
            <p class="text-muted">Tra cứu và kiểm tra lịch sử điểm danh của toàn bộ sinh viên / nhân viên</p>
        </div>
        <div>
            <a href="/attendance" class="btn btn-primary">Điểm danh mới</a>
        </div>
    </div>

    <!-- Bộ lọc kết hợp -->
    <div class="content-card filter-card">
        <div class="card-header">
            <h3>Bộ lọc tra cứu kết hợp</h3>
        </div>
        <div class="card-body">
            <form action="/attendance/history" method="GET" class="filter-form-grid">
                <div class="form-group">
                    <label for="date">Theo Ngày</label>
                    <input type="date" id="date" name="date" class="form-control" value="<%= filterDate %>">
                </div>

                <div class="form-group">
                    <label for="member_id">Theo Thành viên</label>
                    <select id="member_id" name="member_id" class="form-control">
                        <option value="">-- Tất cả thành viên --</option>
                        <% members.forEach(m => { %>
                            <option value="<%= m.id %>" <%= (filterMemberId == m.id) ? 'selected' : '' %>>
                                <%= m.code %> - <%= m.full_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="status">Theo Trạng thái</label>
                    <select id="status" name="status" class="form-control">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="on_time" <%= (filterStatus === 'on_time') ? 'selected' : '' %>>Đúng giờ</option>
                        <option value="late" <%= (filterStatus === 'late') ? 'selected' : '' %>>Đi muộn</option>
                    </select>
                </div>

                <div class="form-actions-inline">
                    <button type="submit" class="btn btn-primary">Áp dụng lọc</button>
                    <a href="/attendance/history" class="btn btn-outline">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng kết quả lịch sử -->
    <div class="content-card">
        <div class="card-header">
            <h3>Kết quả tra cứu (<%= totalRecords %> bản ghi)</h3>
            <% if (totalRecords > 0) { %>
                <span class="text-muted text-sm">
                    Hiển thị <%= (currentPage - 1) * limit + 1 %> - <%= Math.min(currentPage * limit, totalRecords) %> trên <%= totalRecords %>
                </span>
            <% } %>
        </div>
        <div class="card-body">
            <% if (historyList && historyList.length > 0) { %>
                <div class="table-responsive">
                    <table class="table-standard">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Mã số</th>
                                <th>Họ và tên</th>
                                <th>Khoa / Phòng ban</th>
                                <th>Ca làm việc</th>
                                <th>Giờ Check-in</th>
                                <th>Giờ Check-out</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% historyList.forEach(item => { %>
                                <tr>
                                    <td><strong><%= formatDateVN(item.attendance_date) %></strong></td>
                                    <td><%= item.member_code %></td>
                                    <td><span class="text-truncate-name" title="<%= item.member_name %>"><%= item.member_name %></span></td>
                                    <td><span class="badge badge-info text-truncate-sm" title="<%= item.department %>"><%= item.department %></span></td>
                                    <td><span class="text-truncate-sm" title="<%= item.shift_name %>"><%= item.shift_name %></span></td>
                                    <td><span class="badge badge-info"><%= formatTimeVN(item.check_in) %></span></td>
                                    <td>
                                        <% if (item.check_out) { %>
                                            <span class="badge badge-secondary"><%= formatTimeVN(item.check_out) %></span>
                                        <% } else { %>
                                            <span class="badge badge-warning">Chưa check-out</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.status === 'on_time') { %>
                                            <span class="badge badge-success">Đúng giờ</span>
                                        <% } else { %>
                                            <span class="badge badge-danger">Đi muộn</span>
                                        <% } %>
                                    </td>
                                    <td><span class="text-truncate-sm" title="<%= item.notes || '' %>"><%= item.notes || '-' %></span></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang (Pagination Controls) -->
                <% if (totalPages > 1) { %>
                    <div class="pagination-bar">
                        <div class="pagination-info">
                            Trang <strong><%= currentPage %></strong> / <strong><%= totalPages %></strong>
                        </div>
                        <div class="pagination-actions">
                            <% if (currentPage > 1) { %>
                                <a href="/attendance/history?page=<%= currentPage - 1 %><%= typeof filterQueryStr !== 'undefined' ? filterQueryStr : '' %>" class="btn btn-sm btn-outline">
                                    &laquo; Trang trước
                                </a>
                            <% } else { %>
                                <button type="button" class="btn btn-sm btn-outline" disabled>&laquo; Trang trước</button>
                            <% } %>

                            <span class="pagination-current"><%= currentPage %></span>

                            <% if (currentPage < totalPages) { %>
                                <a href="/attendance/history?page=<%= currentPage + 1 %><%= typeof filterQueryStr !== 'undefined' ? filterQueryStr : '' %>" class="btn btn-sm btn-outline">
                                    Trang sau &raquo;
                                </a>
                            <% } else { %>
                                <button type="button" class="btn btn-sm btn-outline" disabled>Trang sau &raquo;</button>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <div class="empty-state">
                    <p>Không có dữ liệu điểm danh nào phù hợp với bộ lọc hiện tại.</p>
                </div>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
