<%- include('sidebar') %>
<div id="sidebarBackdrop" class="sidebar-backdrop" aria-hidden="true"></div>
<div class="app-main-wrapper">
    <header class="app-topbar">
        <button type="button" id="mobileMenuBtn" class="topbar-btn" aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="appSidebar">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <div class="topbar-brand">
            <span class="material-symbols-outlined brand-icon">fact_check</span>
            <span class="brand-text">Quản lý điểm danh</span>
        </div>
        <div class="topbar-actions">
            <button type="button" class="topbar-btn js-theme-toggle" aria-label="Chuyển giao diện sáng/tối">
                <span class="material-symbols-outlined theme-toggle-icon">dark_mode</span>
            </button>
        </div>
    </header>
